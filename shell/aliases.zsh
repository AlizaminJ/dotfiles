# Private paths, account names, and project-specific shortcuts belong in ~/.zshrc.local.
alias m0='arch -x86_64 /bin/zsh'
alias m1='arch -arm64 /bin/zsh'
alias gs='git status'
alias gd='git diff'
alias ga='git add'
alias gcm='git commit -m'
alias gp='git push'
alias gl='git pull'
alias gb='git branch'
alias gch='git checkout'
alias speedtest='networkquality -v'
alias ta='terraform apply'
alias ti='terraform init'
alias tp='terraform plan'
alias ts='terraform show'
alias tf='terraform fmt'
alias tv='terraform validate'
alias sa='source .venv/bin/activate'
alias sz='exec /bin/zsh -l'
alias cz='code ~/.zshrc.local'
alias st='tmux source-file ~/.tmux.conf'
